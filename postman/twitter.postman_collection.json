          }
        }
      ]
    },
    {
      "name": "5. Отмена действий",
      "item": [
        {
          "name": "Убрать реакцию",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{readerToken}}"
              }
            ],
            "url": "{{baseUrl}}/messages/{{messageId}}/reactions"
          }
        },
        {
          "name": "Отписаться",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{readerToken}}"
              }
            ],
            "url": "{{baseUrl}}/subscribers/my/{{authorId}}"
          }
        },
        {
          "name": "Лента пуста",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{readerToken}}"
              }
            ],
            "url": "{{baseUrl}}/messages/feed"
          }
        },
        {
          "name": "Удалить сообщение",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": "{{baseUrl}}/messages/{{messageId}}"
          }
        },
        {
          "name": "404 после удаления",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/messages/{{messageId}}"
          }
        },
        {
          "name": "Снять producer",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{authorId}}/roles/producer"
          }
        }
      ]
    }
  ]
}