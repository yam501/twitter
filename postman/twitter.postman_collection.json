            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{readerToken}}"
              }
            ],
            "url": "{{baseUrl}}/subscribers/my/{{authorId}}"
          }
        },
        {
          "name": "422: подписка на себя",
          "request": {
            "method": "POST",
            "header": [
              {
