                }
              }
            }
          }
        },
        {
          "name": "422: неизвестная реакция",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{readerToken}}"
              }
            ],
            "url": "{{baseUrl}}/messages/{{messageId}}/reactions",
            "body": {
